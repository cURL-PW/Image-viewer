{
  "name": "image-viewer",
  "version": "0.1.0",
  "description": "タグ付け機能付きローカル画像ビューアー (WD14 tagger)",
  "main": "out/main/index.js",
  "author": "cURL-PW",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:scale": "vitest run --config vitest.scale.config.ts",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "e2e": "npm run build && playwright test",
    "extension": "node scripts/build-extension.mjs",
    "postinstall": "node scripts/install-electron-binary.mjs"
  },
  "dependencies": {
    "heic-decode": "^2.1.0",
    "onnxruntime-node": "^1.29.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "dev.curlpw.image-viewer",
    "productName": "Image Viewer",
    "directories": {
      "output": "release"
    },
    "artifactName": "Image-Viewer-${version}-${os}-${arch}.${ext}",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "npmRebuild": false,
    "asarUnpack": [
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**",
      "**/node_modules/onnxruntime-node/**",
      "**/node_modules/libheif-js/**",
      "**/node_modules/heic-decode/**"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.photography"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Graphics"
    },
    "nsis": {
      "artifactName": "Image-Viewer-Setup-${version}-${arch}.${ext}"
    }
  }
}
